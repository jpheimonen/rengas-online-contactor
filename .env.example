# Copy to .env. Every provider key is optional: a channel without its key simulates.
HOST=127.0.0.1
PORT=8787
# Public URL (for example a tunnel) that Twilio calls back. Needed only for real voice calls.
PUBLIC_BASE_URL=
# At least 32 characters. Encrypts stored provider keys.
APP_SECRET=change-me-to-a-long-random-string-0000
DATABASE_PATH=./data/app.db
RESEND_API_KEY=
# Sender for real email. Resend's sandbox allows only onboarding@resend.dev until you verify a domain.
RESEND_FROM=onboarding@resend.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
# Real sends allowed per browser session. Codes for verifying recipients don't count.
SEND_LIMIT_EMAIL_PER_HOUR=3
SEND_LIMIT_SMS_PER_HOUR=3
SEND_LIMIT_CALLS_PER_HOUR=2
SEND_LIMIT_PER_DAY=10
