{
  "name": "rengas-online-contactor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rengas Online Contactor: a joke escalation ladder that really sends email, SMS and calls when you add API keys. Real sends go only to recipients you have verified; without keys everything is simulated.",
  "scripts": {
    "dev": "pnpm --parallel --filter @rengas/server --filter @rengas/web run dev",
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' run build",
    "start": "pnpm --filter @rengas/server run start",
    "typecheck": "pnpm -r --filter './apps/*' --filter './packages/*' run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter './apps/*' --filter './packages/*' run test",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
